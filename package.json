{
  "name": "@planning/easel",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "onboard": "rer setup",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "rer queue verify:app -- sh -c \"pnpm run build && pnpm run typecheck && pnpm run test:easel\"",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:easel": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.1.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.55.1",
    "@runeditrun/rer": "0.2.80",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/xml2js": "0.4.14",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1",
    "xml-crypto": "6.1.2"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  },
  "description": "Easel: owned financial planning, budgeting and forecasting for one company.",
  "repository": "https://github.com/just-every/run-easel"
}
