{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planning-easel",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easel",
      "database_id": "local-easel-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "MAIL_FROM": "Easel <noreply@run-easel.com>",
    "MAIL_PROVIDER": "resend"
  }
}
