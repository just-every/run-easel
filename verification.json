        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/metric-tasks\" node tests/metric-tasks-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/calendar\" node tests/calendar-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/statements\" node tests/statements-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/department-statements\" node tests/department-statements-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/sandboxes\" node tests/sandboxes-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/history\" node tests/history-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/dashboards\" node tests/dashboards-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/gauge\" node tests/gauge-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/revenue-drivers\" node tests/revenue-drivers-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/us-defaults\" perl -e 'setpgrp(0,0); exec @ARGV' -- node tests/us-defaults-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/working-capital\" perl -e 'setpgrp(0,0); exec @ARGV' -- node tests/working-capital-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/translation\" node tests/translation-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/cash-alerts\" node tests/cash-alerts-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/variance-commentary\" node tests/variance-commentary-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/weekly-cash\" node tests/weekly-cash-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/forecast-learning\" node tests/forecast-learning-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/board-pack\" node tests/board-pack-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/bi-feeds\" node tests/bi-feeds-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/constraints\" node tests/constraint-responses-browser.mjs"
      ]
    },
    {
      "name": "model-scale",
      "browser": false,
      "commands": [
        "node tests/model-scale.mjs \"nightly-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}\""
      ]
    },
    {
      "name": "model-background",
      "browser": false,
      "commands": [
        "node tests/calculation-background.mjs"
      ]
    },
    {
      "name": "model-browser",
      "browser": true,
      "commands": [
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-model-calculation\" node tests/calculation-browser.mjs"
      ]
    }
  ],
