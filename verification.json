{
  "push": [
    {
      "name": "types-site",
      "browser": false,
      "commands": [
        "node scripts/contract-docs.mjs check",
        "node node_modules/@runeditrun/rer/edition-authoring/cli.mjs check",
        "pnpm exec rer check",
        "pnpm typecheck",
        "pnpm exec rer build --site"
      ]
    },
    {
      "name": "domain-1",
      "browser": false,
      "commands": [
        "node --test --test-concurrency=1 --test-shard=1/4 tests/*.test.mjs"
      ]
    },
    {
      "name": "domain-2",
      "browser": false,
      "commands": [
        "node --test --test-concurrency=1 --test-shard=2/4 tests/*.test.mjs"
      ]
    },
    {
      "name": "domain-3",
      "browser": false,
      "commands": [
        "node --test --test-concurrency=1 --test-shard=3/4 tests/*.test.mjs"
      ]
    },
    {
      "name": "domain-4",
      "browser": false,
      "commands": [
        "node --test --test-concurrency=1 --test-shard=4/4 tests/*.test.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "commands": [
        "pnpm exec rer build",
        "node tests/approval-chains-browser.mjs",
        "node tests/connectors-browser.mjs --existing-build",
        "node tests/intacct-browser.mjs --existing-build",
        "node tests/netsuite-browser.mjs --existing-build",
        "node tests/weekly-cash-browser.mjs --existing-build",
        "node tests/hris-browser.mjs --existing-build",
        "node tests/excel-browser.mjs",
        "node tests/spend-browser.mjs",
        "node tests/gauge-schedule-browser.mjs",
        "node tests/bi-feeds-browser.mjs --existing-build",
        "node tests/pipeline-browser.mjs --existing-build"
      ]
    },
    {
      "name": "agent-door",
      "browser": true,
      "commands": [
        "node scripts/agent-docs.mjs check",
        "pnpm exec rer build",
        "pnpm typecheck",
        "node --test --test-concurrency=1 tests/mcp.test.mjs tests/audit.test.mjs tests/mcp-client.test.mjs",
        "node tests/agent-attribution-browser.mjs",
        "node tests/agent-docs-browser.mjs",
        "perl -e 'alarm 1200; exec @ARGV' -- node tests/mcp-client-browser.mjs",
        "perl -e 'alarm 1200; exec @ARGV' -- node tests/agent-capacity-browser.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "journeys",
      "browser": true,
      "commands": [
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof\" node tests/browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/mobile\" node tests/mobile.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/cash-health\" node tests/cash-health-browser.mjs",
        "EASEL_EVIDENCE=\"$RUNNER_TEMP/easel-proof/reforecasts\" node tests/reforecasts-browser.mjs",
