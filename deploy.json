{
  "version": 1,
  "project": "just-every/planning-easel",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "crons": [
    "*/15 * * * *"
  ],
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_FROM": "Easel <noreply@run-easel.com>",
    "MAIL_PROVIDER": "resend"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "GAUGE_ORIGIN",
      "environment": "GAUGE_ORIGIN",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
